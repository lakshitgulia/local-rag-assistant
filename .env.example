# Copy this file to .env and fill in your own values. .env is gitignored.

# --- Local file scan ---
LOCAL_SCAN_DIR=~/Downloads

# Ollama (local, no API key needed)
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
# llama3.2:3b is the default: on an 8GB-RAM machine llama3.1:8b caused
# swap-thrashing and 100-320s responses. llama3.1:8b is still installed and
# config-swappable here if you're running on a machine with more headroom.
OLLAMA_LLM_MODEL=llama3.2:3b
